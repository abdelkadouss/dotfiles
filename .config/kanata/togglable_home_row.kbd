(defcfg
  process-unmapped-keys yes
  concurrent-tap-hold yes
)

(defsrc
  esc
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  caps a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft
                              spc
)

(defvar
  tap-time 300
  hold-time 300
)

(defalias
  to-rmods (layer-toggle rmods)
  to-lmods (layer-toggle lmods)
  to-esc (layer-toggle lesc)

  ;; caps-ctrl
  escctrl (tap-hold-press $tap-time $hold-time esc @to-esc) 

  ;; the space mod
  mspc (tap-hold-press $tap-time $hold-time spc (layer-toggle space-down))

  ;; home row mods
  s (tap-hold-press $tap-time $hold-time (multi spc s) (multi @to-lmods lctl))
  d (tap-hold-press $tap-time $hold-time (multi spc d) (multi @to-lmods lmet))
  f (tap-hold-press $tap-time $hold-time (multi spc f) (multi @to-lmods lalt))
  j (tap-hold-press $tap-time $hold-time (multi spc j) (multi @to-rmods ralt))
  k (tap-hold-press $tap-time $hold-time (multi spc k) (multi @to-rmods rmet))
  l (tap-hold-press $tap-time $hold-time (multi spc l) (multi @to-rmods rctl))

)

(deflayer base 
  grv
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
@escctrl a  s    d    f    g    h    j    k    l    ;    '    ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft
                            @mspc
)

(deflayer lmods
  grv
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  esc  a    lctl lmet lalt g    h    j    k    l    ;    '    ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft
                              spc
)

(deflayer rmods
  grv
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  esc  a    s    d    f    g    h    ralt rmet rctl ;    '    ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft
                              spc
)

(deflayer space-down
  (multi spc grv)
  (multi spc grv) (multi spc 1) (multi spc 2) (multi spc 3) (multi spc 4) (multi spc 5) (multi spc 6) (multi spc 7) (multi spc 8) (multi spc 9) (multi spc 0) (multi spc -) (multi spc =) (multi spc bspc)
  (multi spc tab)  (multi spc q) (multi spc w) (multi spc e) (multi spc r) (multi spc t) (multi spc y) (multi spc u) (multi spc i) (multi spc o) (multi spc p) (multi spc [) (multi spc ]) (multi spc \)
@escctrl (multi spc a) @s @d @f (multi spc g) (multi spc h) @j @k @l (multi spc ;) (multi spc ')    (multi spc ret)
  lsft (multi spc z) (multi spc x) (multi spc c) (multi spc v) (multi spc b) (multi spc n) (multi spc m) (multi spc ,) (multi spc .) (multi spc /) rsft
                              spc
)

(deflayer lesc
  _
  grv  C-1  C-2  C-3  C-4  C-5  C-6  C-7  C-8  C-9  C-0  C--  C-=  C-bspc
C-tab  C-q  C-w  C-e  C-r  C-t  C-y  C-u  C-i  C-o  C-p  C-[  C-]  C-\
C-esc  C-a  C-s  C-d  C-f  C-g  ◀    ▼    ▲    ▶    C-;  C-'  C-ret
  lsft C-z  C-x  C-c  C-v  C-b  C-n  C-m  C-,  C-.  C-/    rsft
                            C-spc
)
