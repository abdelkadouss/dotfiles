{
  cpbb: [
    # cmd runners
    just
    mask
    mprocs

    nu # a modern shell

    # dev tools
    zellij # terminal multiplexer
    bat # cat files with syntax highlighting
    { name: fd, input: fd-find } # file finder
    ripgrep # grep
    tlrc # cheatsheets
    lstr # file tree
    kdlfmt # format kdl files

  ]

  eget: [
    { name: d2, input: terrastruct/d2 } # diagram as code compiler
    { name: meteor, input: stefanlogue/meteor } # a tool to write a better commit messages in Chaa'Allah
    {
      name: sqlc
      input: sqlc-dev/sqlc
      asset: ^.tar.gz
    } # sql compiler

    {
      name: ollama
      input: ollama/ollama
      asset: ^.tgz
    } # an ai tool

    # { # FIXME: need dep and lib system
    #   name: neovim,
    #   input: neovim/neovim
    #   all: true
    #   target: nvim
    # } # text editor

  ]

  go: [
    # ai
    {
      name: opencode
      input: github.com/opencode-ai/opencode@latest
    }

  ]

}
