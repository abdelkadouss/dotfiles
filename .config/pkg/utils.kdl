eget {
  // fs
  lnk "yarlson/lnk" // a dotfile manager
  afx "babarot/afx" // a package manager
  // utils
  carapace "carapace-sh/carapace-bin" file="carapace"

  ollama "ollama/ollama" asset="^.tgz" // a tool to manage the ai models
}

cargo {
  bat // a better cat
  sd // a better sed
  // visual
  starship // shell prompt
  vivid // LS_COLORS generator
  pastel // a tool to convert colors and work with them
  tokei // a tool to count your code
  //tldr "tlrc" // cheatsheets
  binwalk // a tool to check the binary (good for checking if there malware)
  neda "neda-cli"
  kanata
}
