{
  eget: [
    # fs
    { name: gomi, input: babarot/gomi } # an rm alternate
    { name: lnk, input: yarlson/lnk } # a dotfile manager
    { name: afx, input: babarot/afx } # a package manager
    { name: fzf, input: junegunn/fzf } # a file fuzzy finder

    # utils
    {
      name: carapace
      input: carapace-sh/carapace-bin
      file: carapace
    }

  ]

  cpbb: [
    # fs
    zoxide # a faster cd

    # visual
    viu

    starship # shell prompt
    vivid # LS_COLORS generator
    pastel # a tool to convert colors and work with them


  ]

}
