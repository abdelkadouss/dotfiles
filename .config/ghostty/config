# theme
# background = #11111b
# background = #181825
background = #000000
theme = catppuccin-mocha
# theme = tokyonight_night

# font
font-family = Monaspace Radon Var
font-family-italic = Monaspace Krypton Var
font-family-bold-italic = Monaspace Krypton Var
font-variation = wght=500
font-variation-bold = wght=1100
font-size = 25
font-feature = ss01
font-feature = ss02
font-feature = ss03
font-feature = ss04
font-feature = ss05
font-feature = ss06
font-feature = ss07
font-feature = ss08
font-feature = ss09
font-feature = calt
font-feature = liga

# cursor
cursor-style-blink = true
cursor-invert-fg-bg

# window
window-decoration = auto
window-padding-y = 4
# background-opacity = 0.95
background-blur = 1

# macos
macos-titlebar-style = hidden
macos-titlebar-proxy-icon = hidden
macos-option-as-alt = true
macos-non-native-fullscreen = true
macos-icon = paper
macos-icon-frame = beige
macos-titlebar-proxy-icon = visible

# keybinds
keybind = global:cmd+grave_accent=toggle_quick_terminal
keybind = global:cmd+alt+g=scroll_to_top
keybind = global:cmd+alt+shift+G=scroll_to_top
keybind = global:super+l=goto_split:right
keybind = super+h=goto_split:left
keybind = super+h=goto_split:left
keybind = super+b=scroll_page_up
keybind = super+f=scroll_page_down
keybind = super+shift+g=scroll_to_bottom
keybind = super+g>g=scroll_to_top
keybind = super+alt+v=write_scrollback_file:open
keybind = super+alt+b=write_scrollback_file:paste
