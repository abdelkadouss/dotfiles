# theme
# background = #11111b
# background = #181825
background = #000000
# theme = catppuccin-mocha
theme = tokyonight_night

# font
font-family = MonaspiceRnVar Nerd Font
font-size = 25
font-feature = ss01
font-feature = ss02
font-feature = ss03
font-feature = ss04
font-feature = ss05
font-feature = ss06
font-feature = ss07
font-feature = ss08
font-feature = ss09
font-feature = calt
font-feature = liga

# cursor
cursor-style-blink = true

# window
window-decoration = auto
window-padding-y = 4
cursor-invert-fg-bg
# background-opacity = 0.95
background-blur = 1

# macos
macos-titlebar-style = hidden
macos-titlebar-proxy-icon = hidden
macos-option-as-alt = true
macos-non-native-fullscreen = true
macos-icon = paper
macos-icon-frame = beige
macos-titlebar-proxy-icon = visible

# keybinds
keybind = global:cmd+grave_accent=toggle_quick_terminal
keybind = global:cmd+alt+g=scroll_to_top
keybind = global:cmd+alt+shift+G=scroll_to_top
