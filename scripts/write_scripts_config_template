config_file_path=~/.config/scripts.conf
config_file_content="";

red() {
    printf "\033[1;31m%s\033[0m\n" "$1"
}
green() {
    printf "\033[1;32m%s\033[0m\n" "$1"
}
yellow() {
    printf "\033[1;33m%s\033[0m\n" "$1"
}
blue() {
    printf "\033[1;34m%s\033[0m\n" "$1"
}
purple() {
    printf "\033[1;35m%s\033[0m\n" "$1"
}
code() {
    printf "$ \033[1;35m%s\033[0m" "$1"
}

#if [ -f "$config_file_path" ]; then
#    red "Config file already exists, skipping"
#    exit 0
#fi

blue "To list items in a menu u run:"
code "ls | "
read menu_list
config_file_content+="menu_list:$menu_list\n"

blue "To copy something to clipboard u run:"
code "echo 'something' | " 
read clipboard_copy
config_file_content+="clipboard_copy:$clipboard_copy\n"

blue "To paste something from clipboard u run:"
code "contents=\$("
read clipboard_paste
purple ")"
config_file_content+="clipboard_paste:$clipboard_paste\n"

green "Writing config file"
#printf "%s" "$config_file_content" > "$config_file_path"
green "Done 🌻, thanks to Allah"
